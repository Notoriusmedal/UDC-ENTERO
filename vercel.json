{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix angular-udc ci",
  "buildCommand": "npm --prefix angular-udc run build",
  "outputDirectory": "angular-udc/dist/angular-udc/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
